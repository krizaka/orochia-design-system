{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": false,
    "jsx": "react-jsx",
    "plugins": [],
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "classes.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "tokens/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.tsx"
  ]
}
