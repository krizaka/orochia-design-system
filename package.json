{
  "name": "@krizaka/orochia-design-system",
  "version": "1.0.0",
  "description": "Tokens and React components shared by the Orochia applications \u2014 dark-first, accessible, with the animated Orochia mark.",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "build:lib": "tsup",
    "start": "next start -p 3002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.428.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "next": "^16.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/orochia-design-system.git"
  },
  "homepage": "https://www.krizaka.com/en/products/orochia",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tailwind-preset.cjs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
