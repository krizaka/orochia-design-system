{
  "name": "@krizaka/orochia-design-system",
  "version": "4.0.0",
  "description": "The Orochia identity on the Krizaka platform: the Obsidian Velvet Noir theme as --kz-* token overrides and the product composites (LiveBadge, SocialIcon, orochiaButton). The primitives come from @krizaka/ui.",
  "keywords": [
    "orochia",
    "krizaka",
    "design-system",
    "theme",
    "design-tokens",
    "react",
    "tailwindcss",
    "tailwind-v4",
    "components",
    "accessibility"
  ],
  "homepage": "https://github.com/krizaka/orochia-design-system#readme",
  "bugs": "https://github.com/krizaka/orochia-design-system/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/orochia-design-system.git"
  },
  "license": "Apache-2.0",
  "author": "Krizaka (https://www.krizaka.com)",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./classes": {
      "types": "./dist/classes.d.ts",
      "import": "./dist/classes.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "build:lib": "tsup",
    "start": "next start -p 3002",
    "lint": "eslint . --max-warnings 0 && krizaka-ratchet",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:lib && npm run publint && npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib",
    "publint": "publint"
  },
  "dependencies": {
    "@krizaka/tokens": "^2.0.0-beta.2",
    "@krizaka/ui": "^2.0.0-beta.2",
    "lucide-react": "^1.17.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "@krizaka/tailwind": ">=2.0.0-beta.2",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4.1"
  },
  "devDependencies": {
    "@krizaka/config": "^0.1.0",
    "@krizaka/tailwind": "^2.0.0-beta.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "happy-dom": "^20.0.0",
    "next": "^16.4.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  }
}
